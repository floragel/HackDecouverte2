<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: same night blue as the in-app intro, so the hand-off is seamless -->
    <style name="Theme.Lync" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/launcher_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_bg</item>
    </style>
</resources>

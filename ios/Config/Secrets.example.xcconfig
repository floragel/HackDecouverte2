// Copy to Secrets.xcconfig and fill in (or run ./setup.sh to copy from ../local.properties).
// Note: "//" starts a comment in xcconfig, hence the $() trick in the URL.
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_KEY = sb_publishable_xxx
// YES = force the offline demo even with keys
LYNC_DEMO = NO
